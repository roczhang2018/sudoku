{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "Snake Game with Real-time Multiplayer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "deploy": "node scripts/deploy.js",
    "backup": "node scripts/backup.js",
    "test": "jest",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "echo 'Frontend build completed'",
    "build:backend": "echo 'Backend build completed'",
    "service:start": "node scripts/start.js start",
    "service:stop": "node scripts/start.js stop",
    "service:restart": "node scripts/start.js restart",
    "service:status": "node scripts/start.js status"
  },
  "keywords": [
    "snake-game",
    "websocket",
    "real-time",
    "multiplayer",
    "nodejs"
  ],
  "author": "Snake Game Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "chokidar": "^3.5.3",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
